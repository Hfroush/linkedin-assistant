{
  "name": "linkedin-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "sh -c 'set -a && [ -f .env.local ] && . .env.local; set +a; drizzle-kit generate'",
    "db:migrate": "sh -c 'set -a && [ -f .env.local ] && . .env.local; set +a; drizzle-kit migrate'",
    "db:push": "sh -c 'set -a && [ -f .env.local ] && . .env.local; set +a; drizzle-kit push'",
    "db:studio": "sh -c 'set -a && [ -f .env.local ] && . .env.local; set +a; drizzle-kit studio'",
    "seed": "sh -c 'set -a && . .env.local && set +a && npx tsx scripts/seed.ts'",
    "seed-topics": "sh -c 'set -a && . .env.local && set +a && npx tsx scripts/seed-topics.ts'",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.12.0",
    "next": "15.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
