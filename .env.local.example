# Anthropic API key, required for draft, angle, and digest generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Neon Postgres connection string, required by Drizzle and @neondatabase/serverless
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Simple deployment gate for this single-user personal app
# Required in production. Optional in local development.
APP_BASIC_AUTH_USERNAME=change_me
APP_BASIC_AUTH_PASSWORD=change_me_to_a_long_random_password
