# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Planning docs (local only)
.planning/

# Voice profile source (personal writing — must not be committed)
*.docx

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets must never be committed
.env*
# but the example template is safe to commit (placeholder values only)
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/worktrees/
